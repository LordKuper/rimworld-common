<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <!-- Environment variables for test execution -->
  <RunConfiguration>
    <EnvironmentVariables>
      <Variable name="RIMWORLD_DIR" value="D:\Games\Steam\steamapps\common\RimWorld" />
    </EnvironmentVariables>
  </RunConfiguration>

  <!-- NUnit adapter settings.
       InProcess=true: run tests in the testhost process without spawning a sub-process.
       This ensures the RimWorld AssemblyResolve handler (registered by [ModuleInitializer] in
       RimWorldResolverSetup.cs) is live in the same AppDomain that NUnit scans for test types,
       resolving the Assembly-CSharp discovery-time dependency without requiring copy-local DLLs. -->
  <NUnit>
    <InProcess>true</InProcess>
  </NUnit>
</RunSettings>
